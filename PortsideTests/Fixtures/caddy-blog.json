{
  "admin" : {
    "config" : {
      "persist" : false
    },
    "listen" : "127.0.0.1:2019"
  },
  "apps" : {
    "http" : {
      "servers" : {
        "portside" : {
          "automatic_https" : {
            "disable" : true
          },
          "errors" : {
            "routes" : [
              {
                "handle" : [
                  {
                    "body" : "<!doctype html><html><head><meta charset=\"utf-8\"><title>{http.request.host} is not running · Portside</title><style>body{font:16px -apple-system,system-ui,sans-serif;color:#1d1d1f;background:#f5f5f7;display:grid;place-items:center;min-height:100vh;margin:0}main{max-width:32rem;padding:2rem}h1{font-size:1.5rem;margin:0 0 .5rem}p{color:#6e6e73;margin:0}.brand{font-weight:600;color:#0a84ff;margin-bottom:1rem}@media(prefers-color-scheme:dark){body{color:#f5f5f7;background:#1d1d1f}p{color:#a1a1a6}}</style></head><body><main><div class=\"brand\">Portside</div><h1><code>{http.request.host}</code> is not running</h1><p>Start it from the Portside menu bar, then reload this page.</p></main></body></html>",
                    "handler" : "static_response",
                    "headers" : {
                      "Cache-Control" : [
                        "no-store"
                      ],
                      "Content-Type" : [
                        "text/html; charset=utf-8"
                      ]
                    },
                    "status_code" : 502
                  }
                ],
                "match" : [
                  {
                    "host" : [
                      "api.blog.test",
                      "blog.test"
                    ]
                  }
                ],
                "terminal" : true
              }
            ]
          },
          "listen" : [
            ":80"
          ],
          "routes" : [
            {
              "handle" : [
                {
                  "body" : "portside-ok",
                  "handler" : "static_response",
                  "headers" : {
                    "Cache-Control" : [
                      "no-store"
                    ],
                    "Content-Type" : [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code" : 200
                }
              ],
              "match" : [
                {
                  "host" : [
                    "portside-selftest.test"
                  ]
                }
              ],
              "terminal" : true
            },
            {
              "handle" : [
                {
                  "flush_interval" : -1,
                  "handler" : "reverse_proxy",
                  "headers" : {
                    "request" : {
                      "set" : {
                        "Host" : [
                          "{http.reverse_proxy.upstream.hostport}"
                        ],
                        "X-Forwarded-Host" : [
                          "{http.request.hostport}"
                        ]
                      }
                    }
                  },
                  "upstreams" : [
                    {
                      "dial" : "localhost:8185"
                    }
                  ]
                }
              ],
              "match" : [
                {
                  "host" : [
                    "api.blog.test"
                  ]
                }
              ],
              "terminal" : true
            },
            {
              "handle" : [
                {
                  "flush_interval" : -1,
                  "handler" : "reverse_proxy",
                  "headers" : {
                    "request" : {
                      "set" : {
                        "Host" : [
                          "{http.reverse_proxy.upstream.hostport}"
                        ],
                        "X-Forwarded-Host" : [
                          "{http.request.hostport}"
                        ]
                      }
                    }
                  },
                  "upstreams" : [
                    {
                      "dial" : "localhost:5474"
                    }
                  ]
                }
              ],
              "match" : [
                {
                  "host" : [
                    "blog.test"
                  ]
                }
              ],
              "terminal" : true
            },
            {
              "handle" : [
                {
                  "body" : "<!doctype html><html><head><meta charset=\"utf-8\"><title>No site for {http.request.host} · Portside</title><style>body{font:16px -apple-system,system-ui,sans-serif;color:#1d1d1f;background:#f5f5f7;display:grid;place-items:center;min-height:100vh;margin:0}main{max-width:32rem;padding:2rem}h1{font-size:1.5rem;margin:0 0 .5rem}p{color:#6e6e73;margin:0}.brand{font-weight:600;color:#0a84ff;margin-bottom:1rem}@media(prefers-color-scheme:dark){body{color:#f5f5f7;background:#1d1d1f}p{color:#a1a1a6}}</style></head><body><main><div class=\"brand\">Portside</div><h1>No site for <code>{http.request.host}</code></h1><p>Portside has no site with this domain. Add one from the Portside menu bar.</p></main></body></html>",
                  "handler" : "static_response",
                  "headers" : {
                    "Cache-Control" : [
                      "no-store"
                    ],
                    "Content-Type" : [
                      "text/html; charset=utf-8"
                    ]
                  },
                  "status_code" : 404
                }
              ],
              "terminal" : true
            }
          ]
        }
      }
    }
  }
}
